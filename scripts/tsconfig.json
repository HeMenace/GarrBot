{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "./**/*.ts",
    "../src/commands/definitions.ts",
    "../src/tiers.ts",
    "../src/slugify.ts",
    "../src/dictionary.ts",
    "../src/words-file.ts"
  ]
}
